# ==============================================================================
# ASCEND FITNESS PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini API Key for server-side AI coaching & meal scanner
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Optional free fallback for AI meal scanner & coach - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Optional free fallback for AI vision & coach - https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cloudflare Workers AI (Optional free fallback for AI meal scanner vision - https://dash.cloudflare.com)
# Free tier: 10,000 neurons/day, hard $0 ceiling. Token needs Account > Workers AI > Read.
# Privacy: Cloudflare does not retain standard inference inputs/outputs and does not train on customer content.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Supabase Cloud Database (PostgreSQL) - Prevents data loss on mobile devices
# Create a free project at https://supabase.com
# Paste `supabase/schema.sql` into Supabase SQL Editor once
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Supabase Service Role Key (Server-side ONLY - for account deletion cascade & admin operations)
# NEVER prefix with NEXT_PUBLIC_ or expose to the client!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Web Push Notifications (VAPID Keys)
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key_here
VAPID_PRIVATE_KEY=your_private_vapid_key_here
VAPID_SUBJECT=mailto:support@ascendfit.app

# Automated Reminder Dispatch Cron Secret (Secures /api/notifications/dispatch via Bearer auth)
CRON_SECRET=your_random_secret_string_here

# Upstash QStash Integration (Schedule management & native signature verification)
# https://console.upstash.com/qstash
QSTASH_TOKEN=your_qstash_token_here
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key_here
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key_here

# Canonical Production Site URL
NEXT_PUBLIC_SITE_URL=https://ascendtonext.vercel.app

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_ID=your_clarity_project_id

# Sentry Error & Crash Tracking DSN
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@ingest.sentry.io/project-id

# Resend API Key for user feedback & bug report email delivery and account deletion verification
RESEND_API_KEY=re_your_resend_api_key
FEEDBACK_RECIPIENT_EMAIL=your_email@example.com
RESEND_FROM_EMAIL=ASCEND Privacy <onboarding@resend.dev>

# Dedicated Signing Secret for Account Deletion Tokens (Optional - defaults to SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_DELETION_SECRET=your_long_random_hmac_secret_key_here
